index 0000000000000000000000000000000000000000..9efbd50d41eeef2ba0fe76f3c543b62a814b6993
--- /dev/null
+++ b/scripts/gilgal/engine/output.mjs
@@ -0,0 +1,118 @@
+import path from 'node:path'
+import fs from 'node:fs'
+
+export const OUTPUT_TIERS = {
+  COMPACT_SUCCESS: 'COMPACT_SUCCESS',
+  COMPACT_SUCCESS_WITH_WARNINGS: 'COMPACT_SUCCESS_WITH_WARNINGS',
+  FAILURE_OUTPUT: 'FAILURE_OUTPUT'
+}
+
+/**
+ * Filters out repetitive system warnings while preserving unique actionable warnings.
+ */
+export function processWarnings(rawWarnings = []) {
+  const seen = new Set()
+  const filtered = []
+
+  for (const w of rawWarnings) {
+    const trimmed = String(w).trim()
+    if (!trimmed) continue
+
+    // Normalize known noisy node warnings
+    if (trimmed.includes('ExperimentalWarning: SQLite is an experimental feature')) {
+      const key = 'node:sqlite:experimental'
+      if (!seen.has(key)) {
+        seen.add(key)
+        filtered.push({ code: 'SQLITE_EXPERIMENTAL_WARNING', message: 'Node.js SQLite experimental feature warning' })
+      }
+      continue
+    }
+
+    if (!seen.has(trimmed)) {
+      seen.add(trimmed)
+      filtered.push({ code: 'COMPILER_OR_RUNTIME_WARNING', message: trimmed })
+    }
+  }
+
+  return filtered
+}
+
+/**
+ * Formats compact output for terminal while ensuring full diagnostics are saved to files.
+ */
+export function formatTieredOutput({
+  envelope,
+  tier,
+  warnings = [],
+  failureDetail = null
+}) {
+  const p = envelope.evidencePayload
+  const checkId = envelope.checkId || 'CHECK-UNKNOWN'
+  const digestShort = envelope.evidencePayloadDigest ? envelope.evidencePayloadDigest.substring(0, 16) : 'unknown'
+  const candShort = p.candidateSha ? p.candidateSha.substring(0, 7) : 'unknown'
+  const stableShort = p.stableSha ? p.stableSha.substring(0, 7) : 'unknown'
+
+  let terminalText = ''
+
+  if (tier === OUTPUT_TIERS.COMPACT_SUCCESS) {
+    terminalText = [
+      `=== GILGAL SENTINEL [${p.sentinelVersion}] ===`,
+      `State: ${p.state} | Candidate: ${candShort} | Stable: ${stableShort}`,
+      `\u2713 Typecheck: PASS | \u2713 Tests: PASS | \u2713 Replays: PASS | \u2713 Build: PASS`,
+      `Warnings: 0 | Digest: ${digestShort}... | Status: READY (Awaiting Human Approval)`
+    ].join('\n')
+  } else if (tier === OUTPUT_TIERS.COMPACT_SUCCESS_WITH_WARNINGS) {
+    const warnLines = warnings.slice(0, 5).map((w, i) => `  [${i + 1}] ${w.code}: ${w.message}`)
+    terminalText = [
+      `=== GILGAL SENTINEL [${p.sentinelVersion}] ===`,
+      `State: ${p.state} | Candidate: ${candShort} | Stable: ${stableShort}`,
+      `\u2713 Typecheck: PASS | \u2713 Tests: PASS | \u2713 Replays: PASS | \u2713 Build: PASS`,
+      `\u26A0 WARNINGS DETECTED (${warnings.length} non-blocking):`,
+      ...warnLines,
+      `Full Report: .gilgal/evidence/${checkId}.json`,
+      `Digest: ${digestShort}... | Status: READY (Awaiting Human Approval)`
+    ].join('\n')
+  } else {
+    // FAILURE_OUTPUT
+    terminalText = [
+      `=== GILGAL SENTINEL [${p.sentinelVersion}] \u2014 EXECUTION FAILED ===`,
+      `State: ${p.state} | Candidate: ${candShort} | Stable: ${stableShort}`,
+      `\u2717 FAILED STEP: ${failureDetail ? failureDetail.step : 'unknown'}`,
+      failureDetail ? `  Error: ${failureDetail.message}` : '',
+      failureDetail && failureDetail.file ? `  Location: ${failureDetail.file}:${failureDetail.line || ''}` : '',
+      `Full Diagnostics: .gilgal/evidence/${checkId}.json`,
+      `Status: BLOCKED`
+    ].filter(Boolean).join('\n')
+  }
+
+  return terminalText
+}
+
+/**
+ * Saves evidence envelope, compact summary and logs persistently to disk.
+ */
+export function saveEvidenceArtifacts(projectRoot, envelope, compactText, stdoutLog = '', stderrLog = '') {
+  const evDir = path.join(projectRoot, '.gilgal', 'evidence')
+  const logsDir = path.join(evDir, 'logs')
+  fs.mkdirSync(logsDir, { recursive: true })
+
+  const checkId = envelope.checkId || `CHECK-${Date.now()}`
+
+  // 1. Full envelope JSON
+  const jsonPath = path.join(evDir, `${checkId}.json`)
+  fs.writeFileSync(jsonPath, JSON.stringify(envelope, null, 2), 'utf8')
+
+  // 2. Compact text
+  const compactPath = path.join(evDir, `${checkId}.compact.txt`)
+  fs.writeFileSync(compactPath, compactText, 'utf8')
+
+  // 3. Raw stdout/stderr logs
+  if (stdoutLog) {
+    fs.writeFileSync(path.join(logsDir, `${checkId}.stdout.log`), stdoutLog, 'utf8')
+  }
+  if (stderrLog) {
+    fs.writeFileSync(path.join(logsDir, `${checkId}.stderr.log`), stderrLog, 'utf8')
+  }
+
+  return { jsonPath, compactPath }
+}
diff --git a/scripts/gilgal/engine/policy.mjs b/scripts/gilgal/engine/policy.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..87d08dfa66ea2fb7af5903f8b5eafe6d338b23a9
--- /dev/null
+++ b/scripts/gilgal/engine/policy.mjs
@@ -0,0 +1,124 @@
+import { computeSha256, canonicalize } from './canonical.mjs'
+
+export const POLICY_STATES = {
+  POLICY_UNCHANGED: 'POLICY_UNCHANGED',
+  POLICY_STRENGTHENED: 'POLICY_STRENGTHENED',
+  POLICY_CHANGED: 'POLICY_CHANGED',
+  POLICY_WEAKENING_DETECTED: 'POLICY_WEAKENING_DETECTED'
+}
+
+/**
+ * Computes deterministic canonical digest of a policy (config + contracts).
+ */
+export function computePolicyDigest(config = {}, contracts = {}) {
+  const payload = {
+    schemaVersion: '1.0',
+    config,
+    contracts
+  }
+  return computeSha256(canonicalize(payload))
+}
+
+/**
+ * Compares Candidate policy against Trusted STABLE Policy Baseline.
+ */
+export function comparePolicies(stableConfig = {}, stableContracts = {}, candidateConfig = {}, candidateContracts = {}) {
+  const stableDigest = computePolicyDigest(stableConfig, stableContracts)
+  const candidateDigest = computePolicyDigest(candidateConfig, candidateContracts)
+
+  if (stableDigest === candidateDigest) {
+    return {
+      status: POLICY_STATES.POLICY_UNCHANGED,
+      valid: true,
+      stableDigest,
+      candidateDigest,
+      violations: [],
+      reason: 'Poltica de governana idntica  base confivel.'
+    }
+  }
+
+  const violations = []
+
+  // 1. Check Mandatory Suites / Verifications
+  const stableChecks = stableConfig.requiredChecks || ['typecheck', 'test', 'replays', 'build']
+  const candidateChecks = candidateConfig.requiredChecks || ['typecheck', 'test', 'replays', 'build']
+
+  for (const check of stableChecks) {
+    if (!candidateChecks.includes(check)) {
+      violations.push(`Verificao obrigatria '${check}' foi removida ou desativada no candidato.`)
+    }
+  }
+
+  // 2. Check Change Budget expansion
+  const sBudget = stableConfig.changeBudget || {}
+  const cBudget = candidateConfig.changeBudget || {}
+
+  if (sBudget.enabled && !cBudget.enabled) {
+    violations.push('Change Budget estava habilitado na STABLE e foi desativado no candidato.')
+  }
+
+  const budgetLimits = ['maxFiles', 'maxInsertions', 'maxDeletions', 'maxChangedLines']
+  for (const lim of budgetLimits) {
+    if (typeof sBudget[lim] === 'number' && typeof cBudget[lim] === 'number') {
+      if (cBudget[lim] > sBudget[lim]) {
+        violations.push(`Limite de Change Budget '${lim}' foi afrouxado (${sBudget[lim]} -> ${cBudget[lim]}).`)
+      }
+    } else if (typeof sBudget[lim] === 'number' && cBudget[lim] === undefined) {
+      violations.push(`Limite de Change Budget '${lim}' (${sBudget[lim]}) foi removido no candidato.`)
+    }
+  }
+
+  // 3. Check Critical Contracts Preservation
+  const sContracts = stableContracts || {}
+  const cContracts = candidateContracts || {}
+
+  for (const [key, contract] of Object.entries(sContracts)) {
+    if (key === 'replays') continue
+    if (contract && contract.critical) {
+      const candContract = cContracts[key]
+      if (!candContract) {
+        violations.push(`Contrato crtico '${key}' foi excludo no candidato.`)
+      } else if (candContract.critical === false) {
+        violations.push(`Contrato crtico '${key}' foi rebaixado para no-crtico no candidato.`)
+      }
+    }
+  }
+
+  // 4. Check Critical Replays Preservation
+  const sReplays = Array.isArray(sContracts.replays) ? sContracts.replays : []
+  const cReplays = Array.isArray(cContracts.replays) ? cContracts.replays : []
+  const cReplayIds = new Set(cReplays.map((r) => r.id))
+
+  for (const rep of sReplays) {
+    if (rep.critical !== false && !cReplayIds.has(rep.id)) {
+      violations.push(`Regression Replay crtico '${rep.id}' foi removido no candidato.`)
+    }
+  }
+
+  if (violations.length > 0) {
+    return {
+      status: POLICY_STATES.POLICY_WEAKENING_DETECTED,
+      valid: false,
+      stableDigest,
+      candidateDigest,
+      violations,
+      reason: `Enfraquecimento de poltica detectado: ${violations.join('; ')}`
+    }
+  }
+
+  // Check if it's strictly strengthened or generic changed
+  const isStrictlyStrengthened =
+    cReplays.length > sReplays.length ||
+    (typeof cBudget.maxFiles === 'number' && typeof sBudget.maxFiles === 'number' && cBudget.maxFiles < sBudget.maxFiles)
+
+  return {
+    status: isStrictlyStrengthened ? POLICY_STATES.POLICY_STRENGTHENED : POLICY_STATES.POLICY_CHANGED,
+    valid: true,
+    stableDigest,
+    candidateDigest,
+    violations: [],
+    reason: isStrictlyStrengthened
+      ? 'Poltica fortalecida com regras ou contratos adicionais.'
+      : 'Poltica alterada com equivalncia de rigor (requer autorizao explcita).'
+  }
+}
diff --git a/scripts/gilgal/engine/provenance.mjs b/scripts/gilgal/engine/provenance.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..07725e5f5be4c58d24f4a11549662c7237dea3f4
--- /dev/null
+++ b/scripts/gilgal/engine/provenance.mjs
@@ -0,0 +1,187 @@
+import path from 'node:path'
+import fs from 'node:fs'
+import { computeSha256, canonicalize } from './canonical.mjs'
+
+export const VERIFIER_STATES = {
+  TRUSTED_VERIFIER_MATCH: 'TRUSTED_VERIFIER_MATCH',
+  VERIFIER_UPGRADE_PROPOSED: 'VERIFIER_UPGRADE_PROPOSED',
+  VERIFIER_IMPLEMENTATION_MISMATCH: 'VERIFIER_IMPLEMENTATION_MISMATCH'
+}
+
+export const GATE_STATES = {
+  TRUSTED_GATE_MATCH: 'TRUSTED_GATE_MATCH',
+  GATE_UPGRADE_PROPOSED: 'GATE_UPGRADE_PROPOSED',
+  GATE_IMPLEMENTATION_MISMATCH: 'GATE_IMPLEMENTATION_MISMATCH'
+}
+
+/**
+ * Computes deterministic digest of the Sentinel engine implementation files.
+ */
+export function computeSentinelImplementationDigest(engineDir) {
+  if (!fs.existsSync(engineDir)) {
+    throw new Error(`Diretrio do motor Sentinel no encontrado: ${engineDir}`)
+  }
+
+  const entries = fs.readdirSync(engineDir, { withFileTypes: true })
+  const fileDigests = []
+
+  for (const entry of entries) {
+    if (entry.isFile() && (entry.name.endsWith('.mjs') || entry.name.endsWith('.js') || entry.name.endsWith('.json'))) {
+      const fullPath = path.join(engineDir, entry.name)
+      const content = fs.readFileSync(fullPath, 'utf8').replace(/\r\n/g, '\n').replace(/^\uFEFF/, '')
+      const fileDigest = computeSha256(content)
+      fileDigests.push({
+        file: entry.name,
+        digest: fileDigest
+      })
+    }
+  }
+
+  fileDigests.sort((a, b) => (a.file < b.file ? -1 : a.file > b.file ? 1 : 0))
+
+  const payload = {
+    schemaVersion: '1.0',
+    engineFiles: fileDigests
+  }
+
+  return computeSha256(canonicalize(payload))
+}
+
+/**
+ * Computes deterministic digest of the Gate script (promote.mjs).
+ */
+export function computeGateImplementationDigest(gateFilePath) {
+  if (!fs.existsSync(gateFilePath)) {
+    throw new Error(`Arquivo do Gate no encontrado: ${gateFilePath}`)
+  }
+  const content = fs.readFileSync(gateFilePath, 'utf8').replace(/\r\n/g, '\n').replace(/^\uFEFF/, '')
+  return computeSha256(content)
+}
+
+/**
+ * Independently verifies reported verifier digest against disk, and compares with trusted base.
+ */
+export function verifyVerifierProvenance({
+  reportedDigest,
+  candidateEngineDir,
+  trustedEngineDir
+}) {
+  const actualCandidateDigest = computeSentinelImplementationDigest(candidateEngineDir)
+
+  if (reportedDigest && reportedDigest !== actualCandidateDigest) {
+    return {
+      status: VERIFIER_STATES.VERIFIER_IMPLEMENTATION_MISMATCH,
+      valid: false,
+      reportedDigest,
+      actualCandidateDigest,
+      reason: 'O digest declarado pelo Sentinel no confere com o clculo independente dos arquivos em disco.'
+    }
+  }
+
+  let trustedDigest = null
+  if (trustedEngineDir && fs.existsSync(trustedEngineDir)) {
+    try {
+      trustedDigest = computeSentinelImplementationDigest(trustedEngineDir)
+    } catch {
+      // STABLE does not have engine directory (0.2.0 structure)
+      trustedDigest = null
+    }
+  }
+
+  if (trustedDigest && actualCandidateDigest === trustedDigest) {
+    return {
+      status: VERIFIER_STATES.TRUSTED_VERIFIER_MATCH,
+      valid: true,
+      reportedDigest: actualCandidateDigest,
+      trustedDigest,
+      reason: 'Motor do Sentinel idntico  base confivel.'
+    }
+  }
+
+  return {
+    status: VERIFIER_STATES.VERIFIER_UPGRADE_PROPOSED,
+    valid: true,
+    reportedDigest: actualCandidateDigest,
+    trustedDigest,
+    reason: 'Atualizao de motor do Sentinel proposta (requer autorizao de governana com digest vinculado).'
+  }
+}
+
+/**
+ * Independently verifies Gate implementation digest against disk, and compares with trusted base.
+ */
+export function verifyGateProvenance({
+  reportedGateDigest,
+  candidateGatePath,
+  trustedGatePath
+}) {
+  const actualCandidateGateDigest = computeGateImplementationDigest(candidateGatePath)
+
+  if (reportedGateDigest && reportedGateDigest !== actualCandidateGateDigest) {
+    return {
+      status: GATE_STATES.GATE_IMPLEMENTATION_MISMATCH,
+      valid: false,
+      reportedGateDigest,
+      actualCandidateGateDigest,
+      reason: 'O digest declarado do Gate no confere com o clculo independente do arquivo em disco.'
+    }
+  }
+
+  let trustedGateDigest = null
+  if (trustedGatePath && fs.existsSync(trustedGatePath)) {
+    trustedGateDigest = computeGateImplementationDigest(trustedGatePath)
+  }
+
+  if (trustedGateDigest && actualCandidateGateDigest === trustedGateDigest) {
+    return {
+      status: GATE_STATES.TRUSTED_GATE_MATCH,
+      valid: true,
+      reportedGateDigest: actualCandidateGateDigest,
+      trustedGateDigest,
+      reason: 'Implementao do Gate idntica  base confivel.'
+    }
+  }
+
+  return {
+    status: GATE_STATES.GATE_UPGRADE_PROPOSED,
+    valid: true,
+    reportedGateDigest: actualCandidateGateDigest,
+    trustedGateDigest,
+    reason: 'Atualizao do Promotion Gate proposta (requer autorizao de governana com digest vinculado).'
+  }
+}
+
+/**
+ * Validates governance approval binding tuple.
+ */
+export function verifyGovernanceBinding({
+  approvalData,
+  currentCandidateSha,
+  currentTrustedVerifierDigest,
+  proposedVerifierDigest,
+  currentTrustedGateDigest,
+  proposedGateDigest,
+  candidatePolicyDigest
+}) {
+  if (!approvalData || typeof approvalData !== 'object') {
+    return { valid: false, code: 'MISSING_GOVERNANCE_DATA', reason: 'Dados de autorizao de governana ausentes.' }
+  }
+
+  if (approvalData.candidateSha !== currentCandidateSha) {
+    return { valid: false, code: 'APPROVAL_STALE', reason: `Aprovao de governana vinculada a commit diferente (${approvalData.candidateSha} vs ${currentCandidateSha}).` }
+  }
+
+  if (approvalData.proposedVerifierDigest && approvalData.proposedVerifierDigest !== proposedVerifierDigest) {
+    return { valid: false, code: 'APPROVAL_STALE', reason: 'Digest do motor proposto mudou desde a aprovao de governana.' }
+  }
+
+  if (approvalData.proposedGateDigest && approvalData.proposedGateDigest !== proposedGateDigest) {
+    return { valid: false, code: 'APPROVAL_STALE', reason: 'Digest do Gate proposto mudou desde a aprovao de governana.' }
+  }
+
+  if (approvalData.candidatePolicyDigest && approvalData.candidatePolicyDigest !== candidatePolicyDigest) {
+    return { valid: false, code: 'APPROVAL_STALE', reason: 'Digest da poltica do candidato mudou desde a aprovao de governana.' }
+  }
+
+  return { valid: true, code: 'GOVERNANCE_BOUND' }
+}
diff --git a/scripts/gilgal/promote.mjs b/scripts/gilgal/promote.mjs
index 3e69c0cc2e9cb4ee273f1fc45f72bcc4d42aa3ca..03f02b7e93a18abec5f08c5e7527f13a77a139f3 100644

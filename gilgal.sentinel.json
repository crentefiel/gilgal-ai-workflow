{
  "version": 1,
  "stable": {
    "ref": "main"
  },
  "candidate": {
    "ref": "HEAD"
  },
  "checks": {
    "typecheck": {
      "enabled": true,
      "critical": true,
      "command": "npm --prefix sentinel run typecheck"
    },
    "tests": {
      "enabled": true,
      "critical": true,
      "command": "npm --prefix sentinel test"
    },
    "build": {
      "enabled": true,
      "critical": true,
      "command": "npm --prefix sentinel run build"
    }
  },
  "contractsFile": "gilgal.contracts.json",
  "reports": {
    "directory": ".gilgal/reports",
    "json": true,
    "markdown": true,
    "includeDiff": false
  },
  "stateDirectory": ".gilgal/state",
  "baselinesDirectory": ".gilgal/baselines",
  "defaults": {
    "timeoutMs": 120000,
    "outputLimitBytes": 51200
  },
  "git": {
    "requireCleanWorkingTree": true,
    "requireStableAncestor": true
  },
  "gate": {
    "blockOnNonCriticalFailure": false
  }
}

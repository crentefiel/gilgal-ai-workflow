{
  "name": "@gilgal/sentinel",
  "version": "0.2.0",
  "private": true,
  "description": "Reference implementation of the GILGAL Sentinel verification orchestrator",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "files": [
    "dist/src",
    "examples",
    "README.md"
  ],
  "bin": {
    "gilgal": "dist/src/cli.js",
    "gilgal-sentinel": "dist/src/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build --silent && node scripts/run-tests.mjs",
    "sentinel": "npm run build --silent && node dist/src/cli.js sentinel --config ../gilgal.sentinel.json"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2"
  }
}

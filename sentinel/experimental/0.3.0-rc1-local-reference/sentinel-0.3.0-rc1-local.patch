+++ b/scripts/gilgal/engine/check-engine.mjs
@@ -0,0 +1,321 @@
+import path from 'node:path'
+import fs from 'node:fs'
+import { fileURLToPath } from 'node:url'
+import { execSync } from 'node:child_process'
+import { computeSha256, computeCanonicalDigest, canonicalize } from './canonical.mjs'
+import { deriveContextState, CONTEXT_STATES } from './context.mjs'
+import { computeSentinelImplementationDigest, computeGateImplementationDigest, verifyVerifierProvenance, verifyGateProvenance } from './provenance.mjs'
+import { comparePolicies, computePolicyDigest, POLICY_STATES } from './policy.mjs'
+import { createArtifactRecord } from './artifacts.mjs'
+import { formatTieredOutput, saveEvidenceArtifacts, processWarnings, OUTPUT_TIERS } from './output.mjs'
+
+export const GILGAL_PROTOCOL_VERSION = '0.5.0'
+export const GILGAL_SENTINEL_VERSION = '0.3.0-RC1'
+
+const __filename = fileURLToPath(import.meta.url)
+const __dirname = path.dirname(__filename)
+
+function runCommandCapture(cmd, cwd) {
+  const startTime = Date.now()
+  try {
+    const stdout = execSync(cmd, {
+      cwd,
+      encoding: 'utf8',
+      stdio: ['pipe', 'pipe', 'pipe']
+    })
+    return {
+      success: true,
+      exitCode: 0,
+      stdout: stdout || '',
+      stderr: '',
+      durationMs: Date.now() - startTime
+    }
+  } catch (err) {
+    return {
+      success: false,
+      exitCode: err.status || 1,
+      stdout: err.stdout ? err.stdout.toString() : '',
+      stderr: err.stderr ? err.stderr.toString() : (err.message || ''),
+      durationMs: Date.now() - startTime
+    }
+  }
+}
+
+export async function executeSentinelCheck({
+  projectRoot,
+  workPath,
+  stablePath,
+  stableSha,
+  candidateSha,
+  profile = 'FULL',
+  customConfig = null,
+  customContracts = null,
+  customStableConfig = null,
+  customStableContracts = null,
+  customReceipt = undefined
+}) {
+  const checkStartTime = Date.now()
+  const checkId = `CHECK-${new Date().toISOString().replace(/[-:TZ.]/g, '').substring(0, 15)}`
+  const engineDir = __dirname
+
+  // 1. Load Configurations & Contracts
+  const config = customConfig || JSON.parse(fs.readFileSync(path.join(projectRoot, '.gilgal', 'config.json'), 'utf8').replace(/^\uFEFF/, ''))
+  const contracts = customContracts || (fs.existsSync(path.join(projectRoot, '.gilgal', 'contracts.json'))
+    ? JSON.parse(fs.readFileSync(path.join(projectRoot, '.gilgal', 'contracts.json'), 'utf8').replace(/^\uFEFF/, ''))
+    : {})
+
+  const stableConfig = customStableConfig || config
+  const stableContracts = customStableContracts || contracts
+
+  // 2. Derive Topological Context State
+  let diffStats = { filesChanged: 0, insertions: 0, deletions: 0, files: [] }
+  try {
+    const diffOut = execSync(`git diff --numstat ${stableSha}..${candidateSha}`, { cwd: workPath, encoding: 'utf8', stdio: ['pipe', 'pipe', 'pipe'] })
+    const lines = diffOut.split('\n').filter(Boolean)
+    let insTotal = 0
+    let delTotal = 0
+    const files = []
+    for (const l of lines) {
+      const parts = l.trim().split(/\s+/)
+      if (parts.length >= 3) {
+        const ins = parts[0] === '-' ? 0 : Number(parts[0]) || 0
+        const del = parts[1] === '-' ? 0 : Number(parts[1]) || 0
+        insTotal += ins
+        delTotal += del
+        files.push({ file: parts.slice(2).join(' '), insertions: ins, deletions: del })
+      }
+    }
+    diffStats = { filesChanged: files.length, insertions: insTotal, deletions: delTotal, files }
+  } catch {
+    // diff failed
+  }
+
+  const context = deriveContextState({
+    projectRoot: workPath,
+    stableSha,
+    headSha: candidateSha,
+    diffStats,
+    customReceipt
+  })
+
+  // 3. Verifier Provenance & Gate Provenance
+  const sentinelImplementationDigest = computeSentinelImplementationDigest(engineDir)
+  const candidateGatePath = path.join(workPath, 'scripts', 'gilgal', 'promote.mjs')
+  const proposedGateDigest = fs.existsSync(candidateGatePath) ? computeGateImplementationDigest(candidateGatePath) : 'unbound_gate_digest'
+
+  // 4. Policy Comparison
+  const policyComparison = comparePolicies(stableConfig, stableContracts, config, contracts)
+
+  const artifacts = []
+  const accumulatedStdout = []
+  const accumulatedStderr = []
+  const detectedWarnings = []
+
+  let overallSuccess = true
+  let failureDetail = null
+
+  // If context is DIRTY or DIVERGED_BRANCH, fail fast
+  if (context.state === CONTEXT_STATES.DIRTY || context.state === CONTEXT_STATES.DIVERGED_BRANCH) {
+    overallSuccess = false
+    failureDetail = {
+      step: 'context',
+      message: context.reason
+    }
+  }
+
+  // If policy was weakened, fail
+  if (policyComparison.status === POLICY_STATES.POLICY_WEAKENING_DETECTED) {
+    overallSuccess = false
+    failureDetail = {
+      step: 'policy',
+      message: policyComparison.reason
+    }
+  }
+
+  const pkgPath = path.join(workPath, 'package.json')
+  const pkg = fs.existsSync(pkgPath) ? JSON.parse(fs.readFileSync(pkgPath, 'utf8')) : {}
+  const scripts = pkg.scripts || {}
+
+  // 5. Run TYPECHECK if eligible
+  if (overallSuccess && scripts.typecheck) {
+    const res = runCommandCapture('npm run typecheck', workPath)
+    accumulatedStdout.push(res.stdout)
+    accumulatedStderr.push(res.stderr)
+
+    if (res.stderr) detectedWarnings.push(res.stderr)
+
+    const art = createArtifactRecord({
+      kind: 'typecheck',
+      tool: 'typescript',
+      command: 'npm run typecheck',
+      reportContent: res.stdout + res.stderr,
+      exitCode: res.exitCode,
+      summary: { pass: res.success, durationMs: res.durationMs },
+      workPath
+    })
+    artifacts.push(art)
+
+    if (!res.success) {
+      overallSuccess = false
+      failureDetail = { step: 'typecheck', message: res.stderr || 'Typecheck failed' }
+    }
+  }
+
+  // 6. Run VITEST if eligible
+  if (overallSuccess && scripts.test) {
+    const res = runCommandCapture('npm run test', workPath)
+    accumulatedStdout.push(res.stdout)
+    accumulatedStderr.push(res.stderr)
+
+    if (res.stderr) detectedWarnings.push(res.stderr)
+
+    const art = createArtifactRecord({
+      kind: 'vitest',
+      tool: 'vitest',
+      command: 'npm run test',
+      reportContent: res.stdout + res.stderr,
+      exitCode: res.exitCode,
+      summary: { pass: res.success, durationMs: res.durationMs },
+      workPath
+    })
+    artifacts.push(art)
+
+    if (!res.success) {
+      overallSuccess = false
+      failureDetail = { step: 'vitest', message: res.stderr || 'Vitest test suite failed' }
+    }
+  }
+
+  // 7. Run REGRESSION REPLAYS if eligible
+  const replays = Array.isArray(contracts.replays) ? contracts.replays : []
+  if (overallSuccess && replays.length > 0) {
+    let allReplaysPass = true
+    const replaySummaries = []
+
+    for (const rep of replays) {
+      const res = runCommandCapture(rep.command, workPath)
+      accumulatedStdout.push(res.stdout)
+      accumulatedStderr.push(res.stderr)
+      if (res.stderr) detectedWarnings.push(res.stderr)
+
+      replaySummaries.push({ id: rep.id, name: rep.name, pass: res.success, exitCode: res.exitCode })
+
+      if (!res.success && rep.critical !== false) {
+        allReplaysPass = false
+        failureDetail = { step: `replay:${rep.id}`, message: `Replay failed: ${rep.id}` }
+        break
+      }
+    }
+
+    const art = createArtifactRecord({
+      kind: 'regressionReplay',
+      tool: 'gilgal-replay-runner',
+      command: 'runReplays',
+      reportContent: JSON.stringify(replaySummaries),
+      exitCode: allReplaysPass ? 0 : 1,
+      summary: { replaysTotal: replays.length, replaysPassed: replaySummaries.filter((r) => r.pass).length },
+      workPath
+    })
+    artifacts.push(art)
+
+    if (!allReplaysPass) {
+      overallSuccess = false
+    }
+  }
+
+  // 8. Run BUILD if eligible and not FAST profile
+  if (overallSuccess && profile === 'FULL' && scripts.build) {
+    const res = runCommandCapture('npm run build', workPath)
+    accumulatedStdout.push(res.stdout)
+    accumulatedStderr.push(res.stderr)
+    if (res.stderr) detectedWarnings.push(res.stderr)
+
+    const art = createArtifactRecord({
+      kind: 'build',
+      tool: 'electron-vite',
+      command: 'npm run build',
+      reportContent: res.stdout + res.stderr,
+      exitCode: res.exitCode,
+      summary: { pass: res.success, durationMs: res.durationMs },
+      workPath
+    })
+    artifacts.push(art)
+
+    if (!res.success) {
+      overallSuccess = false
+      failureDetail = { step: 'build', message: res.stderr || 'Build failed' }
+    }
+  }

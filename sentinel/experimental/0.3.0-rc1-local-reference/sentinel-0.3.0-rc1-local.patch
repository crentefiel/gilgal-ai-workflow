+  // 9. Construct Canonical evidencePayload
+  const mergeBase = context.mergeBase || stableSha
+  const evidencePayload = {
+    protocolVersion: GILGAL_PROTOCOL_VERSION,
+    sentinelVersion: GILGAL_SENTINEL_VERSION,
+    sentinelImplementationDigest,
+    proposedGateDigest,
+    profile,
+    state: context.state,
+    stableSha,
+    candidateSha,
+    mergeBase,
+    configDigest: computePolicyDigest(config, {}),
+    contractsDigest: computePolicyDigest({}, contracts),
+    workingTreeClean: context.isClean,
+    artifacts
+  }
+
+  const evidencePayloadDigest = computeCanonicalDigest(evidencePayload)
+
+  // 10. Process warnings & determine output tier
+  const processedWarnings = processWarnings(detectedWarnings)
+  let tier = OUTPUT_TIERS.COMPACT_SUCCESS
+  if (!overallSuccess) {
+    tier = OUTPUT_TIERS.FAILURE_OUTPUT
+  } else if (processedWarnings.length > 0) {
+    tier = OUTPUT_TIERS.COMPACT_SUCCESS_WITH_WARNINGS
+  }
+
+  const wallClockMs = Date.now() - checkStartTime
+  const fullStdout = accumulatedStdout.join('\n')
+  const fullStderr = accumulatedStderr.join('\n')
+
+  const checkEnvelope = {
+    checkId,
+    generatedAt: new Date().toISOString(),
+    profile,
+    evidencePayloadDigest,
+    evidencePayload,
+    telemetry: {
+      wallClockMs,
+      outputBytes: Buffer.byteLength(fullStdout + fullStderr, 'utf8'),
+      outputChars: (fullStdout + fullStderr).length
+    },
+    logReferences: {
+      stdout: `.gilgal/evidence/logs/${checkId}.stdout.log`,
+      stderr: `.gilgal/evidence/logs/${checkId}.stderr.log`
+    }
+  }
+
+  const terminalText = formatTieredOutput({
+    envelope: checkEnvelope,
+    tier,
+    warnings: processedWarnings,
+    failureDetail
+  })
+
+  // 11. Save artifacts persistently
+  saveEvidenceArtifacts(projectRoot, checkEnvelope, terminalText, fullStdout, fullStderr)
+
+  return {
+    success: overallSuccess,
+    tier,
+    checkId,
+    evidencePayloadDigest,
+    checkEnvelope,
+    terminalText,
+    context,
+    policyComparison,
+    warnings: processedWarnings
+  }
+}

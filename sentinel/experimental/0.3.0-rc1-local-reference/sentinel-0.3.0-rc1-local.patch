+} from '../scripts/gilgal/common.mjs'
+
+describe('Sentinel 0.3.0-RC1: JCS RFC 8785 & Adversarial Security Suite', () => {
+  const dummyStable = '1111111111111111111111111111111111111111'
+  const dummyCandidate = '2222222222222222222222222222222222222222'
+
+  describe('1. JCS Smoke Tests (7/7)', () => {
+    it('SMOKE-01: Property Ordering', () => {
+      expect(canonicalize({ b: 1, a: 2, c: 3 })).toBe('{"a":2,"b":1,"c":3}')
+    })
+    it('SMOKE-02: Nested Objects', () => {
+      expect(canonicalize({ z: { b: 1, a: 2 }, y: [{ d: 4, c: 3 }] })).toBe('{"y":[{"c":3,"d":4}],"z":{"a":2,"b":1}}')
+    })
+    it('SMOKE-03: Array Order Preservation', () => {
+      expect(canonicalize([3, 2, 1])).toBe('[3,2,1]')
+    })
+    it('SMOKE-04: Unicode UTF-8 Determinism', () => {
+      expect(canonicalize({ text: 'LAN House 2.0 — Validação' })).toBe('{"text":"LAN House 2.0 — Validação"}')
+    })
+    it('SMOKE-05: Escaped Characters', () => {
+      expect(canonicalize({ msg: 'line1\nline2\t"quoted"' })).toBe('{"msg":"line1\\nline2\\t\\"quoted\\""}')
+    })
+    it('SMOKE-06: Numeric Serialization (int, float, neg, zero)', () => {
+      expect(canonicalize({ int: 42, neg: -17, float: 3.14159, zero: 0 })).toBe('{"float":3.14159,"int":42,"neg":-17,"zero":0}')
+    })
+    it('SMOKE-07: Null and Boolean', () => {
+      expect(canonicalize({ active: true, disabled: false, data: null })).toBe('{"active":true,"data":null,"disabled":false}')
+    })
+  })
+
+  describe('2. RFC 8785 Conformance Vectors (Independent / Edge Cases)', () => {
+    it('RFC8785-01: UTF-16 Code Unit Property Sorting (ASCII vs Unicode code points)', () => {
+      // RFC 8785 §3.2.3: Sort by UTF-16 code units
+      const input = { '\u00e9': 1, 'a': 2, 'Z': 3, '1': 4 }
+      expect(canonicalize(input)).toBe('{"1":4,"Z":3,"a":2,"\u00e9":1}')
+    })
+
+    it('RFC8785-02: Negative Zero (-0) must be serialized as 0', () => {
+      // RFC 8785 §3.2.2.3
+      const input = { a: -0, b: 0 }
+      expect(canonicalize(input)).toBe('{"a":0,"b":0}')
+    })
+
+    it('RFC8785-03: Exponential Number Formatting Normalization', () => {
+      const input = { val: 1e6, small: 1e-4 }
+      expect(canonicalize(input)).toBe('{"small":0.0001,"val":1000000}')
+    })
+
+    it('RFC8785-04: Control Characters & Standard JSON Escaping (0x00 - 0x1F)', () => {
+      const input = { ctrl: '\x00\x08\x0c\n\r\t' }
+      expect(canonicalize(input)).toBe('{"ctrl":"\\u0000\\b\\f\\n\\r\\t"}')
+    })
+
+    it('RFC8785-05: Deterministic Serialization Independent of Insertion Order', () => {
+      const obj1 = { alpha: 1, beta: 2, gamma: 3, delta: 4 }
+      const obj2 = { delta: 4, alpha: 1, gamma: 3, beta: 2 }
+      expect(canonicalize(obj1)).toBe(canonicalize(obj2))
+      expect(computeCanonicalDigest(obj1)).toBe(computeCanonicalDigest(obj2))
+    })
+
+    it('RFC8785-06: Deeply Nested Complex Data Structures', () => {
+      const complex1 = {
+        meta: { id: 'test', tags: ['a', 'b'] },
+        payload: { nums: [1, 2, { x: 10, y: 20 }], status: null }
+      }
+      const complex2 = {
+        payload: { status: null, nums: [1, 2, { y: 20, x: 10 }] },
+        meta: { tags: ['a', 'b'], id: 'test' }
+      }
+      expect(canonicalize(complex1)).toBe(canonicalize(complex2))
+      expect(computeCanonicalDigest(complex1)).toBe(computeCanonicalDigest(complex2))
+    })
+  })

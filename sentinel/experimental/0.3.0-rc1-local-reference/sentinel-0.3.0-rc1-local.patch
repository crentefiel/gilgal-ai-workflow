+
+    // G. sentinelImplementationDigest autodeclarado falso -> VERIFIER_IMPLEMENTATION_MISMATCH
+    it('G. VERIFIER-PROVENANCE-01: Rejeita digest autodeclarado diferente do computado em disco', () => {

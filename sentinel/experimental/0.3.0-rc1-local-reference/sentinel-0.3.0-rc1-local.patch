--- /dev/null
+++ b/scripts/benchmark-tokens.mjs
@@ -0,0 +1,96 @@
+import path from 'node:path'
+import fs from 'node:fs'
+import { fileURLToPath } from 'node:url'
+
+const __filename = fileURLToPath(import.meta.url)
+const __dirname = path.dirname(__filename)
+const PROJECT_ROOT = path.resolve(__dirname, '..')
+
+export function calculateOutputProjection(projectRoot = PROJECT_ROOT) {
+  const lastValPath = path.join(projectRoot, '.gilgal', 'state', 'last-validation.json')
+  if (!fs.existsSync(lastValPath)) {
+    throw new Error('No validation state found. Run npm run gilgal:check first.')
+  }
+
+  const lastVal = JSON.parse(fs.readFileSync(lastValPath, 'utf8').replace(/^\uFEFF/, ''))
+  const evPath = path.join(projectRoot, '.gilgal', 'evidence', `${lastVal.checkId}.json`)
+  if (!fs.existsSync(evPath)) {
+    throw new Error(`Evidence envelope not found: ${evPath}`)
+  }
+
+  const envelope = JSON.parse(fs.readFileSync(evPath, 'utf8').replace(/^\uFEFF/, ''))
+  const stdoutPath = path.join(projectRoot, envelope.logReferences.stdout)
+  const stderrPath = path.join(projectRoot, envelope.logReferences.stderr)
+
+  const stdout = fs.existsSync(stdoutPath) ? fs.readFileSync(stdoutPath, 'utf8') : ''
+  const stderr = fs.existsSync(stderrPath) ? fs.readFileSync(stderrPath, 'utf8') : ''
+
+  const fullLogsText = (stdout + '\n' + stderr).trim()
+  const fullBytes = Buffer.byteLength(fullLogsText, 'utf8')
+  const fullChars = fullLogsText.length
+
+  const compactTextPath = path.join(projectRoot, '.gilgal', 'evidence', `${lastVal.checkId}.compact.txt`)
+  const compactText = fs.existsSync(compactTextPath)
+    ? fs.readFileSync(compactTextPath, 'utf8').trim()
+    : (
+        `=== GILGAL SENTINEL [${envelope.evidencePayload.sentinelVersion}] ===\n` +
+        `State: ${envelope.evidencePayload.state} | Candidate: ${envelope.evidencePayload.candidateSha.substring(0, 7)} | Stable: ${envelope.evidencePayload.stableSha.substring(0, 7)}\n` +
+        `\u2713 Typecheck: PASS | \u2713 Tests: PASS | \u2713 Replays: PASS | \u2713 Build: PASS\n` +
+        `Warnings: 0 | Digest: ${envelope.evidencePayloadDigest.substring(0, 16)}... | Status: READY (Awaiting Human Approval)`
+      )
+
+  const compactBytes = Buffer.byteLength(compactText, 'utf8')
+  const compactChars = compactText.length
+
+  const byteReduction = (((fullBytes - compactBytes) / (fullBytes || 1)) * 100).toFixed(2)
+  const charReduction = (((fullChars - compactChars) / (fullChars || 1)) * 100).toFixed(2)
+
+  return {
+    checkId: lastVal.checkId,
+    benchmarkType: 'OUTPUT_SIZE_PROJECTION',
+    baselineFull: {
+      bytes: fullBytes,
+      chars: fullChars,
+      estTokens: Math.round(fullChars / 4),
+      wallClockMs: envelope.telemetry.wallClockMs
+    },
+    compactRendered: {
+      bytes: compactBytes,
+      chars: compactChars,
+      estTokens: Math.round(compactChars / 4)
+    },
+    reductions: {
+      byteReductionPercent: Number(byteReduction),
+      charReductionPercent: Number(charReduction)
+    }
+  }
+}
+
+async function main() {
+  console.log('=== GILGAL SENTINEL: OUTPUT SIZE PROJECTION AUDIT ===\n')
+  const res = calculateOutputProjection(PROJECT_ROOT)
+
+  console.log(`Check ID: ${res.checkId}`)
+  console.log(`Benchmark Type: ${res.benchmarkType}\n`)
+
+  console.log('1. FULL CAPTURED LOGS (Baseline uncompacted execution stream):')
+  console.log(`   Bytes:      ${res.baselineFull.bytes}`)
+  console.log(`   Chars:      ${res.baselineFull.chars}`)
+  console.log(`   Est Tokens: ~${res.baselineFull.estTokens} tokens (~4 chars/token)`)
+  console.log(`   Wall Clock: ${res.baselineFull.wallClockMs} ms (~${(res.baselineFull.wallClockMs / 1000).toFixed(1)}s)\n`)
+
+  console.log('2. COMPACT RENDERED OUTPUT (Sentinel 0.3.0-RC1 Tiered Output):')
+  console.log(`   Bytes:      ${res.compactRendered.bytes}`)
+  console.log(`   Chars:      ${res.compactRendered.chars}`)
+  console.log(`   Est Tokens: ~${res.compactRendered.estTokens} tokens (~4 chars/token)\n`)
+
+  console.log('3. PROJECTED / OBSERVED REDUCTION:')
+  console.log(`   Byte Reduction: ${res.reductions.byteReductionPercent}%`)
+  console.log(`   Char Reduction: ${res.reductions.charReductionPercent}%`)
+  console.log('   Runtime Impact: Execution workload is identical (same checks/replays/build); token ingestion surface reduced.\n')
+}
+
+main().catch((err) => {
+  console.error('Erro na projeo de output:', err.message)
+  process.exit(1)
+})

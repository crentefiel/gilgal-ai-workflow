index 0000000000000000000000000000000000000000..efce0b1612a3f582bcc2b5648f69e77a45bd3c48
--- /dev/null
+++ b/scripts/gilgal/engine/canonical.mjs
@@ -0,0 +1,65 @@
+import crypto from 'node:crypto'
+
+/**
+ * RFC 8785: JSON Canonicalization Scheme (JCS) implementation in pure JavaScript.
+ * Ensures deterministic string representation regardless of object property ordering,
+ * whitespace, platform differences, exponential numbers, or locale.
+ */
+export function canonicalize(obj) {
+  if (obj === null) {
+    return 'null'
+  }
+
+  const type = typeof obj
+
+  if (type === 'boolean') {
+    return obj ? 'true' : 'false'
+  }
+
+  if (type === 'number') {
+    if (!Number.isFinite(obj)) {
+      throw new TypeError('RFC 8785: Numbers must be finite (no NaN, Infinity, -Infinity).')
+    }
+    // RFC 8785 §3.2.2.3: -0 must be serialized as 0
+    if (Object.is(obj, -0) || obj === 0) {
+      return '0'
+    }
+    return JSON.stringify(obj)
+  }
+
+  if (type === 'string') {
+    return JSON.stringify(obj)
+  }
+
+  if (Array.isArray(obj)) {
+    const items = obj.map((item) => (item === undefined || typeof item === 'function' || typeof item === 'symbol' ? 'null' : canonicalize(item)))
+    return `[${items.join(',')}]`
+  }
+
+  if (type === 'object') {
+    // RFC 8785 §3.2.3: Object keys sorted by UTF-16 code units (standard JavaScript sort)
+    const keys = Object.keys(obj).sort((a, b) => (a < b ? -1 : a > b ? 1 : 0))
+    const pairs = []
+
+    for (const key of keys) {
+      const val = obj[key]
+      if (val !== undefined && typeof val !== 'function' && typeof val !== 'symbol') {
+        pairs.push(`${JSON.stringify(key)}:${canonicalize(val)}`)
+      }
+    }
+
+    return `{${pairs.join(',')}}`
+  }
+
+  throw new TypeError(`RFC 8785: Unsupported data type '${type}'`)
+}
+
+export function computeSha256(content) {
+  const str = typeof content === 'string' ? content : canonicalize(content)
+  return crypto.createHash('sha256').update(str, 'utf8').digest('hex')
+}
+
+export function computeCanonicalDigest(payload) {
+  const canonicalString = canonicalize(payload)
+  return computeSha256(canonicalString)
+}

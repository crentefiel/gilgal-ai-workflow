+import path from 'node:path'
+import fs from 'node:fs'
+import { execSync } from 'node:child_process'
+
+/**
+ * 6 Formal States for Topological Context State Machine:
+ * 1. DIRTY: working tree is modified/uncommitted.
+ * 2. STABLE_IDENTITY: HEAD === stableSha and no verifiable promotion receipt is presented.
+ * 3. POST_PROMOTION: HEAD === stableSha AND a verifiable promotion receipt confirms recent promotion to this exact SHA.
+ * 4. WORK_CANDIDATE_ACTIVE: HEAD !== stableSha, mergeBase === stableSha, diff > 0, working tree clean.
+ * 5. CANDIDATE_NO_CHANGES: HEAD !== stableSha, mergeBase === stableSha, diff === 0, working tree clean.
+ * 6. DIVERGED_BRANCH: HEAD !== stableSha, mergeBase !== stableSha (non-linear / diverged history).
+ */
+export const CONTEXT_STATES = {
+  DIRTY: 'DIRTY',
+  STABLE_IDENTITY: 'STABLE_IDENTITY',
+  POST_PROMOTION: 'POST_PROMOTION',
+  WORK_CANDIDATE_ACTIVE: 'WORK_CANDIDATE_ACTIVE',
+  CANDIDATE_NO_CHANGES: 'CANDIDATE_NO_CHANGES',
+  DIVERGED_BRANCH: 'DIVERGED_BRANCH'
+}
+
+function runGit(cmd, cwd) {
+  return execSync(`git ${cmd}`, {
+    cwd,
+    encoding: 'utf8',
+    stdio: ['pipe', 'pipe', 'pipe']
+  }).trim()
+}
+
+function tryRunGit(cmd, cwd) {
+  try {
+    return { ok: true, output: runGit(cmd, cwd) }
+  } catch (err) {
+    return { ok: false, error: err.message }
+  }
+}
+
+export function isWorkingTreeClean(dir) {
+  if (!fs.existsSync(dir)) return true
+  const res = tryRunGit('status --porcelain', dir)
+  if (!res.ok) return true
+  return res.output.trim().length === 0
+}
+
+export function getPromotionReceipt(projectRoot) {
+  const receiptPath = path.join(projectRoot, '.gilgal', 'evidence', 'promoted.json')
+  if (!fs.existsSync(receiptPath)) return null
+  try {
+    const raw = fs.readFileSync(receiptPath, 'utf8').replace(/^\uFEFF/, '')
+    return JSON.parse(raw)
+  } catch {
+    return null
+  }
+}
+
+export function verifyPromotionReceipt(receipt, headSha, stableSha, projectRoot) {
+  if (!receipt || typeof receipt !== 'object') return false
+  if (receipt.promotedSha !== headSha || receipt.promotedSha !== stableSha) return false
+  if (!receipt.promotedSha || receipt.promotedSha.length < 40) return false
+
+  // Verify optional git tag anchor if present
+  if (receipt.tag && projectRoot) {
+    const tagRes = tryRunGit(`tag --points-at ${headSha}`, projectRoot)
+    if (tagRes.ok && tagRes.output.includes(receipt.tag)) {
+      return true
+    }
+  }
+
+  return true
+}
+
+/**
+ * Derives topological context state mathematically without relying on cwd or branch name.
+ */
+export function deriveContextState({
+  projectRoot,
+  stableSha,
+  headSha,
+  diffStats,
+  customReceipt,
+  customIsClean,
+  customMergeBase
+}) {
+  const clean = customIsClean !== undefined ? customIsClean : isWorkingTreeClean(projectRoot)
+  if (!clean) {
+    return {
+      state: CONTEXT_STATES.DIRTY,
+      isClean: false,
+      promotionAllowed: false,
+      reason: 'Working tree contm alteraes no commitadas.'
+    }
+  }
+
+  if (headSha === stableSha) {
+    const receipt = customReceipt !== undefined ? customReceipt : getPromotionReceipt(projectRoot)
+    const hasValidReceipt = verifyPromotionReceipt(receipt, headSha, stableSha, projectRoot)
+
+    if (hasValidReceipt) {
+      return {
+        state: CONTEXT_STATES.POST_PROMOTION,
+        isClean: true,
+        promotionAllowed: false,
+        receipt,
+        reason: 'Estado ps-promoo verificado com recibo formal determinstico.'
+      }
+    }
+
+    return {
+      state: CONTEXT_STATES.STABLE_IDENTITY,
+      isClean: true,
+      promotionAllowed: false,
+      reason: 'Base estvel idntica sem alteraes a promover.'
+    }
+  }
+
+  // HEAD !== stableSha
+  let mergeBase = customMergeBase
+  if (mergeBase === undefined) {
+    const mergeBaseRes = tryRunGit(`merge-base ${headSha} ${stableSha}`, projectRoot)
+    mergeBase = mergeBaseRes.ok ? mergeBaseRes.output.trim() : null
+  }
+
+  if (mergeBase !== stableSha) {
+    return {
+      state: CONTEXT_STATES.DIVERGED_BRANCH,
+      isClean: true,
+      mergeBase,
+      promotionAllowed: false,
+      reason: `Histrico divergente: merge-base (${mergeBase ? mergeBase.substring(0, 7) : 'n/a'}) difere de stableSha (${stableSha.substring(0, 7)}).`
+    }
+  }
+
+  const filesCount = diffStats ? diffStats.filesChanged : 0
+  const linesCount = diffStats ? (diffStats.insertions + diffStats.deletions) : 0
+
+  if (filesCount === 0 && linesCount === 0) {
+    return {
+      state: CONTEXT_STATES.CANDIDATE_NO_CHANGES,
+      isClean: true,
+      mergeBase,
+      promotionAllowed: false,
+      reason: 'Candidato com commit mas sem diferena real de cdigo (diff = 0).'
+    }
+  }
+
+  return {
+    state: CONTEXT_STATES.WORK_CANDIDATE_ACTIVE,
+    isClean: true,
+    mergeBase,
+    promotionAllowed: true,
+    reason: 'Candidato linear ativo com diferenas vlidas para homologao.'
+  }
+}

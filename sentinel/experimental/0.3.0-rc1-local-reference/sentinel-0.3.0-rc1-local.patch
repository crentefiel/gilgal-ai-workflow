@@ -0,0 +1,84 @@
+import fs from 'node:fs'
+import path from 'node:path'
+import { computeSha256, canonicalize } from './canonical.mjs'
+
+/**
+ * Computes deterministic input tree/source digest for a given check type.
+ */
+export function computeInputSourceDigest(kind, workPath) {
+  const fileEntries = []
+
+  if (kind === 'typecheck') {
+    const tsconfigPath = path.join(workPath, 'tsconfig.json')
+    const tsconfigNodePath = path.join(workPath, 'tsconfig.node.json')
+    if (fs.existsSync(tsconfigPath)) {
+      fileEntries.push({ file: 'tsconfig.json', hash: computeSha256(fs.readFileSync(tsconfigPath, 'utf8')) })
+    }
+    if (fs.existsSync(tsconfigNodePath)) {
+      fileEntries.push({ file: 'tsconfig.node.json', hash: computeSha256(fs.readFileSync(tsconfigNodePath, 'utf8')) })
+    }
+  } else if (kind === 'vitest') {
+    const vitestConfig = path.join(workPath, 'vitest.config.ts')
+    if (fs.existsSync(vitestConfig)) {
+      fileEntries.push({ file: 'vitest.config.ts', hash: computeSha256(fs.readFileSync(vitestConfig, 'utf8')) })
+    }
+    const testsDir = path.join(workPath, 'tests')
+    if (fs.existsSync(testsDir)) {
+      const files = fs.readdirSync(testsDir).sort()
+      for (const f of files) {
+        if (f.endsWith('.ts') || f.endsWith('.js')) {
+          fileEntries.push({ file: `tests/${f}`, hash: computeSha256(fs.readFileSync(path.join(testsDir, f), 'utf8')) })
+        }
+      }
+    }
+  } else if (kind === 'regressionReplay') {
+    const contractsPath = path.join(workPath, '.gilgal', 'contracts.json')
+    if (fs.existsSync(contractsPath)) {
+      fileEntries.push({ file: '.gilgal/contracts.json', hash: computeSha256(fs.readFileSync(contractsPath, 'utf8')) })
+    }
+  } else if (kind === 'build') {
+    const viteConfig = path.join(workPath, 'electron.vite.config.ts')
+    const pkgPath = path.join(workPath, 'package.json')
+    if (fs.existsSync(viteConfig)) {
+      fileEntries.push({ file: 'electron.vite.config.ts', hash: computeSha256(fs.readFileSync(viteConfig, 'utf8')) })
+    }
+    if (fs.existsSync(pkgPath)) {
+      fileEntries.push({ file: 'package.json', hash: computeSha256(fs.readFileSync(pkgPath, 'utf8')) })
+    }
+  }
+
+  fileEntries.sort((a, b) => (a.file < b.file ? -1 : a.file > b.file ? 1 : 0))
+  return computeSha256(canonicalize({ kind, inputs: fileEntries }))
+}
+
+/**
+ * Creates structured artifact record linking tool execution to exact inputs and outputs.
+ */
+export function createArtifactRecord({
+  kind,
+  schemaVersion = '1.0',
+  tool,
+  toolVersion = 'unknown',
+  command,
+  reportContent = null,
+  exitCode = 0,
+  summary = {},
+  inputTreeDigest = null,
+  workPath = null
+}) {
+  const commandDigest = computeSha256(command || '')
+  const reportDigest = reportContent ? computeSha256(reportContent) : computeSha256(canonicalize(summary))
+  const finalInputTreeDigest = inputTreeDigest || (workPath ? computeInputSourceDigest(kind, workPath) : 'input_tree_digest_unbound')
+
+  return {
+    kind,
+    schemaVersion,
+    tool,
+    toolVersion,
+    commandDigest,
+    reportDigest,
+    inputTreeDigest: finalInputTreeDigest,
+    exitCode,
+    summary
+  }
+}
